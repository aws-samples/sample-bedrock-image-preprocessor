# Cognito configuration for the demo frontend.
# Copy this file to `.env.production` (or `.env.local`) and fill in the values
# printed by `cdk deploy` (UserPoolId / UserPoolClientId outputs).
#
# Do NOT commit the populated file. These values are not secrets, but they are
# specific to your deployed stack.
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
